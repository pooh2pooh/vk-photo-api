# Access token with the "photos" scope.
# Service token of a community or a user token of a personal profile.
VK_TOKEN=

# API version to use.
VK_API_VERSION=5.199

# Album to display. "saved" is the personal profile "Saved photos" album.
VK_ALBUM_ID=saved

# Owner id. For a personal profile leave empty to use the token owner.
VK_OWNER_ID=

# HTTP server port.
PORT=3001

# Request timeout for a single VK call, ms.
VK_TIMEOUT_MS=10000

# Retry attempts for retryable VK errors (rate limits, network failures).
VK_RETRY_ATTEMPTS=3
